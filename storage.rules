rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function activeMember() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/companies/apex-logistic-group/members/$(request.auth.uid)).data.status == 'active'
        && request.auth.token.email_verified == true;
    }
    match /fleetChat/{userId}/{fileName} {
      allow read: if activeMember();
      allow create, update: if activeMember()
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if activeMember() && request.auth.uid == userId;
    }
  }
}