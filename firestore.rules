rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All authenticated Apex Logistic Group users share the company dataset.
    // Access is limited to signed-in users; never publish this collection.
    match /companies/apex-logistic-group/appData/{documentId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /companies/apex-logistic-group/security/{document=**} {
      // PIN hashes, lockouts and one-time deletion tokens are server-only.
      allow read, write: if false;
    }
    match /companies/apex-logistic-group/deletionAudit/{auditId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Keep legacy per-user records readable/writable during the migration period.
    match /users/{userId}/appData/{documentId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /fleetChat/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.senderEmail == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(['text','senderUid','senderEmail','createdAt','edited','imageUrl','imagePath'])
        && (
          (request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000)
          || (request.resource.data.imageUrl is string && request.resource.data.imagePath is string && request.resource.data.imagePath.matches('fleetChat/' + request.auth.uid + '/.*'))
        );
      allow update: if request.auth != null
        && resource.data.senderUid == request.auth.uid
        && request.resource.data.senderUid == resource.data.senderUid
        && request.resource.data.senderEmail == resource.data.senderEmail
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','edited','updatedAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;
      allow delete: if request.auth != null && resource.data.senderUid == request.auth.uid;
    }
  }
}